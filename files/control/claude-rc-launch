#!/usr/bin/env bash
# Remote-control server launcher — ExecStart of the claude-remote-control@
# template unit (runs as the agent user). The systemd instance %i is either
# "<company>" (the default session, back-compat) or "<company>__<slot>" (a named
# extra session). We derive the company from it so multiple sessions can share
# ONE workspace + env while presenting as distinct --name endpoints in the
# Claude app.
#
# Why a script instead of an inline ExecStart: the template's %i used to be the
# company and was reused for the workspace dir, the EnvironmentFile, AND --name.
# A slotted %i (playground__dev) breaks the workspace path and silently drops
# secrets, so the company/slot split has to happen here, before claude starts.
set -euo pipefail

instance="${1:?usage: claude-rc-launch <company|company__slot>}"
company="${instance%%__*}"
slot=""
[ "$company" != "$instance" ] && slot="${instance#*__}"

# Distinct name per session so the Claude app lists them separately.
name="$company"
[ -n "$slot" ] && name="${company}:${slot}"

# Per-company secrets (GH_TOKEN, GITLAB_TOKEN, GOPRIVATE, …) — the SAME file for
# every session of a company. EnvironmentFile format is `KEY=value`, which is
# also `.`-source-safe (~/.profile already sources these on the box).
envfile="/etc/nightshift/secrets/${company}.env"
if [[ -f "$envfile" ]]; then
  set -a; . "$envfile"; set +a
fi

cd "$HOME/workspace/$company"
exec /usr/bin/claude remote-control --spawn same-dir --name "$name" --capacity 8
