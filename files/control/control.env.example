# Copy to /etc/nightshift/secrets/control.env and replace all placeholders.
# Cloudflare Zero Trust team domain, without scheme or trailing slash.
ACCESS_TEAM_DOMAIN=REPLACE_ME.cloudflareaccess.com

# Comma- or space-separated email addresses allowed to operate the control UI.
ALLOWED_EMAILS=you@example.com

# Optional Cloudflare Access application audience tag.
ACCESS_AUD=REPLACE_ME
